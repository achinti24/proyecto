# URL pública de n8n (sin barra final). Todas las llamadas del frontend van a /webhook/* de esta URL.
VITE_N8N_BASE_URL=https://tu-dominio.ngrok-free.app

# Webhook del Chat Trigger de WF10 (EventPass Assistant)
VITE_N8N_CHAT_URL=https://tu-dominio.ngrok-free.app/webhook/<webhook-id-del-chat>/chat

# Usuario del bot de Telegram (sin @), para el enlace "Abrir bot"
VITE_TELEGRAM_BOT=TuBotEventPass_bot
