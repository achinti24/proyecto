    {
      "id": "38bf0a27-51a1-4835-b6e6-db197fbd79e3",
      "name": "Calcular promociones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "\nconst eventos = $('Filtrar publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst insc = $input.all().map(i => i.json).filter(r => r.inscripcion_id);\nconst ahora = new Date();\nconst iso = ahora.toISOString();\nconst out = [];\n\nfor (const ev of eventos) {\n  const hora = String(ev.hora || '00:00').slice(0, 5);\n  const inicio = new Date(String(ev.fecha) + 'T' + hora + ':00-05:00');\n  if (!isNaN(inicio.getTime()) && inicio <= ahora) continue;\n\n  const delEvento = insc.filter(r => r.evento_id === ev.evento_id);\n  const confirmadas = delEvento.filter(r => (r.estado === 'CONFIRMADA' || r.estado === 'ASISTIO')).length;\n  const libres = Math.max((Number(ev.capacidad) || 0) - confirmadas, 0);\n  if (!libres) continue;\n\n  // Prioridad: fecha_inscripcion ASC (quien lleva mas tiempo esperando)\n  const espera = delEvento.filter(r => r.estado === 'LISTA_ESPERA').sort((a, b) =>\n    String(a.fecha_inscripcion).localeCompare(String(b.fecha_inscripcion)) || (Number(a.orden_espera) || 0) - (Number(b.orden_espera) || 0));\n\n  espera.slice(0, libres).forEach((r, idx) => {\n    const n = idx + 1;\n    out.push({ json: {\n      update: {\n        inscripcion_id: r.inscripcion_id, usuario_id: r.usuario_id, evento_id: r.evento_id, estado: 'CONFIRMADA',\n        fecha_inscripcion: r.fecha_inscripcion, fecha_actualizacion: iso,\n        nombre_acreditacion: r.nombre_acreditacion || '', observaciones: r.observaciones || '',\n        origen: r.origen || 'WEB', orden_espera: ''\n      },\n      auditoria: {\n        auditoria_id: 'AUD-' + Date.now() + '-' + Math.floor(Math.random() * 100000), inscripcion_id: r.inscripcion_id,\n        usuario_id: r.usuario_id, evento_id: r.evento_id, accion: 'PROMOVER', estado_anterior: 'LISTA_ESPERA',\n        estado_nuevo: 'CONFIRMADA', fecha: iso, resultado: 'OK', detalle: 'Reasignacion automatica, orden ' + n + ' de ' + Math.min(libres, espera.length)\n      },\n      reasignacion: {\n        reasignacion_id: 'REA-' + Date.now() + '-' + Math.floor(Math.random() * 100000), evento_id: r.evento_id,\n        inscripcion_id: r.inscripcion_id, usuario_id: r.usuario_id, fecha: iso, orden_lista: n,\n        estado_anterior: 'LISTA_ESPERA', estado_nuevo: 'CONFIRMADA'\n      },\n      notif: {\n        usuario_id: r.usuario_id, tipo: 'REASIGNACION_CUPO', titulo: 'Se liberó un cupo para ti',\n        mensaje: 'Buenas noticias: se liberó un cupo y tu inscripción a \"' + ev.nombre + '\" pasó a CONFIRMADA. Te esperamos el ' + ev.fecha + ' ' + hora + ' en ' + ev.lugar + '.',\n        evento_id: r.evento_id, inscripcion_id: r.inscripcion_id,\n        clave_idempotencia: ['REASIGNACION_CUPO', r.usuario_id, r.evento_id, r.inscripcion_id].join('|')\n      }\n    } });\n  });\n}\nreturn out;\n"
      }
    },
