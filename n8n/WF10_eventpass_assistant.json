    {
      "id": "19c973a1-401d-4a54-ae90-357eaf334f20",
      "name": "Armar mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        300
      ],
      "parameters": {
        "jsCode": "const p = $('Preparar mensaje').first().json;\nconst out = String($input.first().json.output || '[sin respuesta del modelo: ' + String(($input.first().json.error && ($input.first().json.error.message || $input.first().json.error)) || 'error') + ']').slice(0, 4000);\nconst t = Date.now();\nconst base = { conversation_id: p.conversation_id, usuario_id: p.usuario_id, visitor_id: p.visitor_id };\nreturn [\n  { json: { ...base, message_id: 'MSG-' + t + '-U', rol: 'USER', mensaje: p.mensaje, timestamp: p.ahora } },\n  { json: { ...base, message_id: 'MSG-' + t + '-A', rol: 'ASSISTANT', mensaje: out, timestamp: new Date().toISOString() } }\n];"
      }
    },
