    {
      "id": "aac769a6-e3e3-4fcb-9e74-b705b0fbfb34",
      "name": "Existe conversacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "jsCode": "const p = $('Preparar mensaje').first().json;\nconst filas = $('Leer conversaciones').all().map(i => i.json);\nconst ex = filas.find(r => r.conversation_id === p.conversation_id);\nreturn [{ json: { ...p, nueva: !ex, fecha_inicio: ex ? ex.fecha_inicio : p.ahora } }];"
      }
    },
