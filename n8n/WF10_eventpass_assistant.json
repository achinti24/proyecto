      "id": "14cbb329-1f97-4d32-8869-7ccc09e3786d",
      "name": "Preparar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst meta = j.metadata || {};\nconst texto = String(j.chatInput || '').trim().slice(0, 1000);\nconst sid = String(j.sessionId || '').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 64) || ('anon' + Date.now());\nconst usuario = /^USR-/i.test(String(meta.usuario_id || '')) ? String(meta.usuario_id).toUpperCase() : '';\nreturn [{ json: { conversation_id: 'CONV-' + sid, visitor_id: usuario ? '' : 'VIS-' + sid, usuario_id: usuario, mensaje: texto, ahora: new Date().toISOString() } }];"
      }
    },
