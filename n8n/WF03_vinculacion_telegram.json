    {
      "id": "b6b42610-6d50-4947-becf-4d8f2def6714",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst crypto = require('crypto');\nconst entrada = $('Validar entrada').first().json;\nconst usuarioId = $('Validar sesion').first().json.usuario_id;\nconst vincs = $('Buscar vinculaciones').all().map(i => i.json).filter(r => r.usuario_id === usuarioId && r.estado === 'ACTIVA');\nconst codigos = $('Buscar codigos').all().map(i => i.json).filter(r => r.usuario_id === usuarioId);\n\nif (entrada.accion === 'estado') {\n  const v = vincs[0];\n  return [{ json: { kind: 'estado', respuesta: { vinculado: !!v, telegram_username: v ? (v.telegram_username || '') : '' }, message: v ? 'Telegram vinculado' : 'Telegram no vinculado' } }];\n}\n\nif (vincs.length) return fail(409, 'YA_VINCULADO', 'Tu cuenta ya tiene un Telegram vinculado');\n\nconst ahora = new Date();\nconst alfabeto = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';\nlet codigo = '';\nfor (let i = 0; i < 6; i++) codigo += alfabeto[crypto.randomInt(alfabeto.length)];\n\nconst out = [{ json: {\n  kind: 'nuevo',\n  nuevo: { codigo_id: 'COD-' + crypto.randomUUID(), usuario_id: usuarioId, codigo, creado_en: ahora.toISOString(),\n           expira_en: new Date(ahora.getTime() + 10 * 60 * 1000).toISOString(), estado: 'PENDIENTE', usado_en: '' },\n  respuesta: { codigo, expira_en: new Date(ahora.getTime() + 10 * 60 * 1000).toISOString(), instruccion: '/vincular ' + codigo },\n  message: 'Envia /vincular ' + codigo + ' a tu bot de Telegram en los proximos 10 minutos'\n} }];\n\n// Los codigos PENDIENTE anteriores del usuario pasan a CANCELADO\nfor (const c of codigos.filter(r => r.estado === 'PENDIENTE')) {\n  out.push({ json: { kind: 'cancelar', cancelar: {\n    codigo_id: c.codigo_id, usuario_id: c.usuario_id, codigo: c.codigo, creado_en: c.creado_en,\n    expira_en: c.expira_en, estado: 'CANCELADO', usado_en: c.usado_en || '' } } });\n}\nreturn out;\n"
      }
    },
