        "jsCode": "\nconst m = $input.first().json.message || {};\nconst texto = String(m.text || '').trim();\nconst chat_id = m.chat && m.chat.id !== undefined ? String(m.chat.id) : '';\nconst username = (m.from && m.from.username) || '';\nconst ayuda = '🎃 ¡Buuu! Soy el bot de EventPass. Para vincular tu cuenta genera un código en la web (Perfil > Telegram) y envíalo así:\\n/vincular CODIGO';\nconst r = texto.match(/^\\/vincular(?:@\\w+)?\\s+([A-Za-z0-9]{4,12})\\s*$/i);\nif (r) return [{ json: { accion: 'vincular', chat_id, username, codigo: r[1].toUpperCase() } }];\nif (/^\\/vincular/i.test(texto)) return [{ json: { accion: 'ayuda', chat_id, username, reply: '🕯️ Falta el código. Usa: /vincular CODIGO' } }];\nreturn [{ json: { accion: 'ayuda', chat_id, username, reply: ayuda } }];\n"
      }
    },
