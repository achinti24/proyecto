    {
      "id": "c18470a7-76a5-40fb-8f7b-11abc495f051",
      "name": "Validar sesion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst entrada = $('Validar entrada').first().json;\nconst fila = $input.all().map(i => i.json).find(r => r.session_token === entrada.token);\nif (!fila || fila.estado !== 'ACTIVA') return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\nif (new Date(fila.expira_en) <= new Date()) return fail(401, 'SESION_INVALIDA', 'La sesión expiró');\nreturn [{ json: { usuario_id: fila.usuario_id } }];\n"
      }
    },
