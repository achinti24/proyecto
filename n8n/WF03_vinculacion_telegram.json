    {
      "id": "7b4a940b-af26-48a5-9494-7b939084842f",
      "name": "Evaluar codigo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        940
      ],
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst p = $('Parsear mensaje').first().json;\nconst norm = (s) => String(s || '').trim().toUpperCase();\nconst cod = $('Leer codigo').all().map(i => i.json).find(r => r.codigo && norm(r.codigo) === norm(p.codigo));\nconst vincs = $('Leer vinculaciones').all().map(i => i.json).filter(r => r.vinculacion_id && r.estado === 'ACTIVA');\nconst err = (reply) => [{ json: { resultado: 'ERROR', reply } }];\n\nif (!cod) return err('💀 Código no válido. Genera uno nuevo desde tu perfil en EventPass.');\nif (cod.estado === 'USADO') return err('🪦 Ese código ya fue utilizado. Genera uno nuevo desde EventPass.');\nif (cod.estado !== 'PENDIENTE') return err('Ese codigo ya no esta disponible. Genera uno nuevo desde EventPass.');\n\nconst upd = { codigo_id: cod.codigo_id, usuario_id: cod.usuario_id, codigo: cod.codigo, creado_en: cod.creado_en,\n              expira_en: cod.expira_en, estado: cod.estado, usado_en: cod.usado_en || '' };\n\nif (new Date(cod.expira_en) <= new Date()) {\n  return [{ json: { resultado: 'EXPIRADO', reply: '⌛ El código expiró. Genera uno nuevo desde EventPass.', update: { ...upd, estado: 'EXPIRADO' } } }];\n}\nif (vincs.some(v => String(v.chat_id) === String(p.chat_id) && v.usuario_id !== cod.usuario_id)) return err('Este chat de Telegram ya esta vinculado a otra cuenta.');\nif (vincs.some(v => v.usuario_id === cod.usuario_id)) return err('Tu cuenta de EventPass ya tiene un Telegram vinculado.');\n\nconst ahora = new Date().toISOString();\nreturn [{ json: {\n  resultado: 'OK',\n  reply: '🎃 ¡Listo! Tu Telegram quedó vinculado a EventPass. Desde ahora recibirás aquí tus confirmaciones, avisos de lista de espera y recordatorios. 🦇',\n  update: { ...upd, estado: 'USADO', usado_en: ahora },\n  vinculacion: { vinculacion_id: 'VIN-' + crypto.randomUUID(), usuario_id: cod.usuario_id, chat_id: String(p.chat_id),\n                 telegram_username: p.username || '', fecha_vinculacion: ahora, estado: 'ACTIVA' }\n} }];\n"
      }
    },
