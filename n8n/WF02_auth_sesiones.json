    {
      "parameters": {
        "jsCode": "\nconst entrada = $('Validar entrada').first().json;\nconst fail = (status, code, message, update) => [{ json: { error: { status, code, message }, ...(update ? { update } : {}) } }];\n\nconst sesion = $('Buscar sesion').all().map(i => i.json).find(r => r.session_token === entrada.token);\nif (!sesion) return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\nif (sesion.estado !== 'ACTIVA') return fail(401, 'SESION_INVALIDA', 'La sesión está cerrada o expirada');\n\nconst ahora = new Date();\nconst base = {\n  session_id: sesion.session_id, usuario_id: sesion.usuario_id, session_token: sesion.session_token,\n  creada_en: sesion.creada_en, expira_en: sesion.expira_en, estado: sesion.estado,\n  cerrada_en: sesion.cerrada_en, ultima_validacion: sesion.ultima_validacion\n};\n\nif (new Date(sesion.expira_en) <= ahora) {\n  return fail(401, 'SESION_INVALIDA', 'La sesión expiró', { ...base, estado: 'EXPIRADA' });\n}\n\nif (entrada.accion === 'logout') {\n  return [{ json: { update: { ...base, estado: 'CERRADA', cerrada_en: ahora.toISOString() }, respuesta: { cerrada: true }, message: 'Sesión cerrada' } }];\n}\n\nconst usuario = $input.all().map(i => i.json).find(r => r.usuario_id === sesion.usuario_id);\nif (!usuario || usuario.estado !== 'ACTIVO') return fail(403, 'USUARIO_INACTIVO', 'La cuenta está inactiva');\n\nreturn [{ json: {\n  update: { ...base, ultima_validacion: ahora.toISOString() },\n  respuesta: { usuario_id: usuario.usuario_id, nombre: usuario.nombre, email: usuario.email_normalizado, expira_en: sesion.expira_en },\n  message: 'Sesión válida'\n} }];\n"
      },
