    {
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst crypto = require('crypto');\nconst entrada = $('Validar entrada').first().json;\nconst invalidas = () => fail(401, 'CREDENCIALES_INVALIDAS', 'Email o contraseña incorrectos');\n\nconst fila = $input.all().map(i => i.json).find(r => r.email_normalizado === entrada.email);\nif (!fila || !fila.password_salt || !fila.password_hash) return invalidas();\n\nconst calculado = crypto.pbkdf2Sync(entrada.password, String(fila.password_salt), 100000, 64, 'sha512');\nconst guardado = Buffer.from(String(fila.password_hash), 'hex');\nif (guardado.length !== calculado.length || !crypto.timingSafeEqual(calculado, guardado)) return invalidas();\n\nif (fila.estado === 'PENDIENTE') return fail(403, 'CUENTA_NO_VERIFICADA', 'Primero verifica tu email con el código que te enviamos.');\nif (fila.estado !== 'ACTIVO') return fail(403, 'USUARIO_INACTIVO', 'La cuenta está inactiva');\n\nconst ahora = new Date();\nconst expira = new Date(ahora.getTime() + 24 * 60 * 60 * 1000);\n\nreturn [{ json: {\n  sesion: {\n    session_id: 'SES-' + crypto.randomUUID(),\n    usuario_id: fila.usuario_id,\n    session_token: crypto.randomBytes(32).toString('hex'),\n    creada_en: ahora.toISOString(),\n    expira_en: expira.toISOString(),\n    estado: 'ACTIVA',\n    cerrada_en: '',\n    ultima_validacion: ahora.toISOString()\n  },\n  usuario: { usuario_id: fila.usuario_id, nombre: fila.nombre, email: fila.email_normalizado }\n} }];\n"
      },
