    {
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst { body = {}, headers = {} } = $input.first().json;\nconst accion = String(body.accion || '').trim();\nconst auth = headers.authorization || '';\nconst token = auth.startsWith('Bearer ') ? auth.slice(7).trim() : '';\n\nif (!['login', 'logout', 'validar'].includes(accion)) return fail(400, 'VALIDACION', 'Acción no válida');\n\nif (accion === 'login') {\n  const email = String(body.email || '').trim().toLowerCase();\n  const password = String(body.password || '');\n  if (!email || !password) return fail(400, 'VALIDACION', 'Email y contraseña son obligatorios');\n  return [{ json: { accion, email, password } }];\n}\n\nif (!token) return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\nreturn [{ json: { accion, token } }];\n"
      },
