    {
      "id": "cb706c43-f8bc-47f9-a423-395fe0e15ecf",
      "name": "Resultado Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        400
      ],
      "parameters": {
        "jsCode": "\nconst p = $('Preparar canales').first().json;\nconst g = $('Resultado Gmail').first().json;\nlet t;\nif (!p.telegram_aplica) {\n  t = { telegram_estado: 'NO_APLICA', telegram_error: 'Usuario sin Telegram vinculado' };\n} else {\n  let r;\n  try { r = $('Telegram').first().json; } catch (e) { r = { error: 'Telegram no se ejecuto' }; }\n  if (!r || r.error || r.ok === false) t = { telegram_estado: 'ERROR', telegram_error: String((r && r.error && (r.error.message || r.error)) || 'Sin respuesta de Telegram').slice(0, 300) };\n  else t = { telegram_estado: 'ENVIADO', telegram_error: '' };\n}\nreturn [{ json: {\n  notificacion_id: p.notificacion_id, usuario_id: p.usuario_id, tipo: p.tipo, titulo: p.titulo, mensaje: p.mensaje_registro || p.mensaje,\n  evento_id: p.evento_id, inscripcion_id: p.inscripcion_id, fecha: new Date().toISOString(),\n  clave_idempotencia: p.clave_idempotencia, ...g, ...t\n} }];\n"
      }
    },
