    {
      "id": "4b30aab1-4af3-4869-a623-121ee5cc9662",
      "name": "Preparar canales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "\nconst e = $('Validar entrada').first().json;\nconst omitir = (resultado, detalle) => [{ json: { omitir: true, resultado, detalle, notificacion_id: e.notificacion_id } }];\nif (!e.valido) return omitir('VALIDACION', e.motivo);\n\nconst previas = $('Buscar previa').all().map(x => x.json).filter(r => r.clave_idempotencia === e.clave_idempotencia);\nif (previas.some(r => r.gmail_estado === 'ENVIADO' || r.telegram_estado === 'ENVIADO')) {\n  return omitir('DUPLICADO', 'La notificacion ya fue enviada (clave ' + e.clave_idempotencia + ')');\n}\n\nconst usuario = $('Buscar usuario').all().map(x => x.json).find(r => r.usuario_id === e.usuario_id);\nif (!usuario) return omitir('USUARIO_NO_ENCONTRADO', 'El usuario no existe');\n// El código de verificación se envía antes de que la cuenta esté ACTIVA\nconst pendienteOk = usuario.estado === 'PENDIENTE' && e.tipo === 'VERIFICACION_EMAIL';\nif (usuario.estado !== 'ACTIVO' && !pendienteOk) return omitir('USUARIO_INACTIVO', 'El usuario esta inactivo');\n\nconst vinc = $('Buscar vinculacion').all().map(x => x.json).find(r => r.usuario_id === e.usuario_id && r.estado === 'ACTIVA');\nconst esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst titulo = esc(e.titulo), mensaje = esc(e.mensaje);\n\nreturn [{ json: {\n  omitir: false, ...e,\n  email: usuario.email_normalizado, nombre: usuario.nombre,\n  gmail_aplica: !!usuario.email_normalizado,\n  chat_id: vinc ? String(vinc.chat_id) : '',\n  telegram_aplica: !!vinc,\n  asunto: '🎃 EventPass: ' + e.titulo,\n  html: '<div style=\"margin:0;padding:24px;background:#0b0812;font-family:Arial,Helvetica,sans-serif\"><div style=\"max-width:540px;margin:0 auto;background:#1b1429;border:1px solid #3a2b55;border-radius:16px;overflow:hidden\"><div style=\"padding:22px 26px;background:linear-gradient(135deg,#2a1846,#2b1305);text-align:center\"><div style=\"font-size:40px\">🎃</div><div style=\"color:#ff7a18;font-size:26px;font-weight:bold;letter-spacing:1px\">EventPass</div><div style=\"color:#b6a8cc;font-size:13px\">Noche de Brujas</div></div><div style=\"padding:26px;color:#f6efe4;font-size:15px;line-height:1.6\"><h2 style=\"color:#ffb347;margin:0 0 12px\">' + titulo + '</h2><p style=\"margin:0 0 12px\">Hola ' + esc(usuario.nombre) + ' 👻,</p><p style=\"margin:0 0 12px\">' + mensaje + '</p></div><div style=\"padding:14px 26px;border-top:1px solid #3a2b55;color:#b6a8cc;font-size:12px;text-align:center\">🦇 EventPass · Eventos de Halloween · Este mensaje también llegó a tu Telegram si lo tienes vinculado</div></div></div>',\n  telegram_texto: '🎃 <b>' + titulo + '</b>\\n\\n' + mensaje + '\\n\\n🦇 <i>EventPass · Noche de Brujas</i>'\n} }];\n"
      }
    },
