      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "\nconst i = $input.first().json;\nconst s = (v) => (v === undefined || v === null ? '' : String(v).trim());\nconst e = {\n  usuario_id: s(i.usuario_id), tipo: s(i.tipo).toUpperCase(), titulo: s(i.titulo), mensaje: s(i.mensaje), mensaje_registro: s(i.mensaje_registro),\n  evento_id: s(i.evento_id), inscripcion_id: s(i.inscripcion_id)\n};\ne.clave_idempotencia = s(i.clave_idempotencia) || [e.tipo, e.usuario_id, e.evento_id, e.inscripcion_id].join('|');\ne.notificacion_id = 'NOT-' + Date.now() + '-' + Math.floor(Math.random() * 10000);\ne.valido = !!(e.usuario_id && e.tipo && e.titulo && e.mensaje);\ne.motivo = e.valido ? '' : 'Faltan campos obligatorios (usuario_id, tipo, titulo, mensaje)';\nreturn [{ json: e }];\n"
      }
    },
