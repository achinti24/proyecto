    {
      "id": "962899bd-7183-4346-8164-965a4670d658",
      "name": "Resultado Gmail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        400
      ],
      "parameters": {
        "jsCode": "\nconst p = $('Preparar canales').first().json;\nif (!p.gmail_aplica) return [{ json: { gmail_estado: 'NO_APLICA', gmail_error: '' } }];\nlet r;\ntry { r = $('Gmail').first().json; } catch (e) { r = { error: 'Gmail no se ejecuto' }; }\nif (!r || r.error || !r.id) return [{ json: { gmail_estado: 'ERROR', gmail_error: String((r && r.error && (r.error.message || r.error)) || 'Sin respuesta de Gmail').slice(0, 300) } }];\nreturn [{ json: { gmail_estado: 'ENVIADO', gmail_error: '' } }];\n"
      }
    },
