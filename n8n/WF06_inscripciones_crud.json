    {
      "id": "486555f3-689c-4a0b-961e-97eaf6fd2aa8",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        500
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst crypto = require('crypto');\nconst e = $('Validar entrada').first().json;\nconst uid = $('Validar sesion').first().json.usuario_id;\n\nconst usuario = $('Buscar usuario').all().map(i => i.json).find(r => r.usuario_id === uid);\nif (!usuario) return fail(404, 'NO_ENCONTRADO', 'Usuario no encontrado');\nif (usuario.estado !== 'ACTIVO') return fail(403, 'USUARIO_INACTIVO', 'La cuenta está inactiva');\n\nconst eventos = $('Leer eventos').all().map(i => i.json).filter(r => r.evento_id);\nconst todas = $('Leer inscripciones').all().map(i => i.json).filter(r => r.inscripcion_id);\nconst evById = {};\nfor (const ev of eventos) evById[ev.evento_id] = ev;\nconst ahora = new Date().toISOString();\n\nconst fila = (r, cambios = {}) => ({\n  inscripcion_id: r.inscripcion_id, usuario_id: r.usuario_id, evento_id: r.evento_id, estado: r.estado,\n  fecha_inscripcion: r.fecha_inscripcion, fecha_actualizacion: r.fecha_actualizacion,\n  nombre_acreditacion: r.nombre_acreditacion || '', observaciones: r.observaciones || '',\n  origen: r.origen || 'WEB', orden_espera: r.orden_espera === undefined ? '' : r.orden_espera, ...cambios\n});\nconst pub = (r) => {\n  const ev = evById[r.evento_id] || {};\n  return { ...fila(r), evento_nombre: ev.nombre || '', evento_categoria: ev.categoria || '', evento_fecha: ev.fecha || '',\n           evento_hora: ev.hora || '', evento_lugar: ev.lugar || '', evento_estado: ev.estado || '' };\n};\nconst aud = (r, accion, anterior, nuevo, detalle) => ({\n  auditoria_id: 'AUD-' + Date.now() + '-' + Math.floor(Math.random() * 1000),\n  inscripcion_id: r.inscripcion_id, usuario_id: uid, evento_id: r.evento_id, accion,\n  estado_anterior: anterior, estado_nuevo: nuevo, fecha: ahora, resultado: 'OK', detalle\n});\nconst notif = (tipo, titulo, mensaje, r) => ({\n  usuario_id: uid, tipo, titulo, mensaje, evento_id: r.evento_id, inscripcion_id: r.inscripcion_id,\n  clave_idempotencia: [tipo, uid, r.evento_id, r.inscripcion_id].join('|')\n});\nconst mias = todas.filter(r => r.usuario_id === uid);\nconst activa = (r) => r.estado === 'CONFIRMADA' || r.estado === 'LISTA_ESPERA' || r.estado === 'ASISTIO';\n\nif (e.accion === 'listar') {\n  const data = mias.map(pub).sort((a, b) => String(b.fecha_inscripcion).localeCompare(String(a.fecha_inscripcion)));\n  return [{ json: { op: 'LISTAR', status: 200, respuesta: data, message: data.length + ' inscripciones' } }];\n}\n\nif (e.accion === 'crear') {\n  const vinc = $('Buscar vinculacion').all().map(i => i.json).find(r => r.usuario_id === uid && r.estado === 'ACTIVA');\n  if (!vinc) return fail(403, 'TELEGRAM_NO_VINCULADO', 'Debes vincular tu Telegram antes de inscribirte');\n  const ev = evById[e.evento_id];\n  if (!ev) return fail(404, 'NO_ENCONTRADO', 'El evento no existe');\n  if (ev.estado !== 'PUBLICADO') return fail(409, 'EVENTO_NO_DISPONIBLE', 'El evento no está disponible para inscripción');\n  const hora = String(ev.hora || '00:00').slice(0, 5);\n  const inicio = new Date(String(ev.fecha) + 'T' + hora + ':00-05:00');\n  if (!isNaN(inicio.getTime()) && inicio <= new Date()) return fail(409, 'EVENTO_NO_DISPONIBLE', 'El evento ya comenzó o finalizó');\n  const previa = mias.find(r => r.evento_id === e.evento_id && activa(r));\n  if (previa) return fail(409, 'YA_INSCRITO', 'Ya tienes una inscripción activa en este evento');\n\n  const delEvento = todas.filter(r => r.evento_id === e.evento_id);\n  const confirmadas = delEvento.filter(r => (r.estado === 'CONFIRMADA' || r.estado === 'ASISTIO')).length;\n  const capacidad = Number(ev.capacidad) || 0;\n  const hayCupo = confirmadas < capacidad;\n  let orden = '';\n  if (!hayCupo) {\n    const ordenes = delEvento.filter(r => r.estado === 'LISTA_ESPERA').map(r => Number(r.orden_espera) || 0);\n    orden = (ordenes.length ? Math.max(...ordenes) : 0) + 1;\n  }\n  const nueva = {\n    inscripcion_id: 'INS-' + crypto.randomUUID(), usuario_id: uid, evento_id: e.evento_id,\n    estado: hayCupo ? 'CONFIRMADA' : 'LISTA_ESPERA', fecha_inscripcion: ahora, fecha_actualizacion: ahora,\n    nombre_acreditacion: e.nombre_acreditacion || usuario.nombre, observaciones: e.observaciones || '',\n    origen: 'WEB', orden_espera: orden\n  };\n  const cuando = ev.fecha + ' ' + hora + ' en ' + ev.lugar;\n  const n = hayCupo\n    ? notif('INSCRIPCION_CONFIRMADA', 'Inscripción confirmada', 'Tu inscripción a \"' + ev.nombre + '\" quedó CONFIRMADA. Te esperamos el ' + cuando + '.', nueva)\n    : notif('LISTA_ESPERA', 'Estás en lista de espera', 'El evento \"' + ev.nombre + '\" está lleno. Quedaste en LISTA DE ESPERA (posición ' + orden + '). Te avisaremos si se libera un cupo.', nueva);\n  return [{ json: {\n    op: 'CREAR', status: 201, write: nueva, respuesta: pub(nueva),\n    message: hayCupo ? 'Inscripción confirmada' : 'Evento lleno: quedaste en lista de espera',\n    auditoria: aud(nueva, 'CREAR', '', nueva.estado, hayCupo ? 'Inscripción con cupo disponible' : 'Evento lleno, lista de espera #' + orden),\n    notif: n\n  } }];\n}\n\nconst objetivo = mias.find(r => r.inscripcion_id === e.inscripcion_id);\nif (!objetivo) return fail(404, 'NO_ENCONTRADO', 'Inscripción no encontrada');\n\nif (e.accion === 'actualizar') {\n  if (objetivo.estado === 'CANCELADA') return fail(409, 'INSCRIPCION_CANCELADA', 'No se puede modificar una inscripción cancelada');\n  if (objetivo.estado === 'ASISTIO') return fail(409, 'INSCRIPCION_CON_ASISTENCIA', 'No se puede modificar una inscripción con el ingreso ya registrado');\n  const cambios = { fecha_actualizacion: ahora };\n  const campos = [];\n  if (e.nombre_acreditacion !== null) { cambios.nombre_acreditacion = e.nombre_acreditacion || usuario.nombre; campos.push('nombre_acreditacion'); }\n  if (e.observaciones !== null) { cambios.observaciones = e.observaciones; campos.push('observaciones'); }\n  const nueva = fila(objetivo, cambios);\n  return [{ json: {\n    op: 'ACTUALIZAR', status: 200, write: nueva, respuesta: pub(nueva), message: 'Inscripción actualizada',\n    auditoria: aud(nueva, 'ACTUALIZAR', objetivo.estado, nueva.estado, 'Campos: ' + campos.join(', ')), notif: null\n  } }];\n}\n\n// cancelar (idempotente: cancelar dos veces no genera cambios)\nif (objetivo.estado === 'ASISTIO') return fail(409, 'INSCRIPCION_CON_ASISTENCIA', 'No se puede cancelar: el ingreso al evento ya fue registrado');\nif (objetivo.estado === 'CANCELADA') {\n  return [{ json: { op: 'NOOP', status: 200, respuesta: pub(objetivo), message: 'La inscripción ya estaba cancelada' } }];\n}\nconst ev = evById[objetivo.evento_id] || {};\nconst nueva = fila(objetivo, { estado: 'CANCELADA', fecha_actualizacion: ahora, orden_espera: '' });\nreturn [{ json: {\n  op: 'CANCELAR', status: 200, write: nueva, respuesta: pub(nueva), message: 'Inscripción cancelada',\n  auditoria: aud(nueva, 'CANCELAR', objetivo.estado, 'CANCELADA', objetivo.estado === 'CONFIRMADA' ? 'Se libera un cupo' : 'Sale de la lista de espera'),\n  notif: notif('INSCRIPCION_CANCELADA', 'Inscripción cancelada', 'Cancelaste tu inscripción a \"' + (ev.nombre || objetivo.evento_id) + '\".', nueva)\n} }];\n"
      }
    },
