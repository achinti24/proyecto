    {
      "id": "b6add5fd-3c70-4863-a6a0-070646c85e93",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst { body = {}, headers = {} } = $input.first().json;\nconst accion = String(body.accion || '').trim();\nconst auth = headers.authorization || '';\nconst token = auth.startsWith('Bearer ') ? auth.slice(7).trim() : '';\nif (!['crear', 'listar', 'actualizar', 'cancelar'].includes(accion)) return fail(400, 'VALIDACION', 'Acción no válida');\nif (!token) return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\n\nconst e = { accion, token };\nif (accion === 'crear') {\n  e.evento_id = String(body.evento_id || '').trim();\n  if (!e.evento_id) return fail(400, 'VALIDACION', 'Falta evento_id');\n}\nif (accion === 'crear' || accion === 'actualizar') {\n  const na = body.nombre_acreditacion === undefined || body.nombre_acreditacion === null ? null : String(body.nombre_acreditacion).trim();\n  const ob = body.observaciones === undefined || body.observaciones === null ? null : String(body.observaciones).trim();\n  if (na !== null && na.length > 80) return fail(400, 'VALIDACION', 'El nombre de acreditación admite máximo 80 caracteres');\n  if (ob !== null && ob.length > 200) return fail(400, 'VALIDACION', 'Las observaciones admiten máximo 200 caracteres');\n  e.nombre_acreditacion = na; e.observaciones = ob;\n}\nif (accion === 'actualizar' || accion === 'cancelar') {\n  e.inscripcion_id = String(body.inscripcion_id || '').trim();\n  if (!e.inscripcion_id) return fail(400, 'VALIDACION', 'Falta inscripcion_id');\n}\nif (accion === 'actualizar' && e.nombre_acreditacion === null && e.observaciones === null) return fail(400, 'VALIDACION', 'No hay nada que actualizar');\nreturn [{ json: e }];\n"
      }
    },
