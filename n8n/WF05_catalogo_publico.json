    {
      "id": "575dbc92-2fa0-4308-b0a6-ad23b9b4aaac",
      "name": "Calcular catalogo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        400
      ],
      "parameters": {
        "jsCode": "const entrada = $('Validar entrada').first().json;\nconst norm = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toLowerCase();\n\n// Eventos publicables (ya filtrados) e inscripciones CONFIRMADAS (ya filtradas)\nconst eventos = $('Filtrar publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst confirmadas = $input.all().map(i => i.json).filter(i => i.evento_id && i.estado === 'CONFIRMADA');\n\nconst ocupados = {};\nfor (const ins of confirmadas) ocupados[ins.evento_id] = (ocupados[ins.evento_id] || 0) + 1;\n\n// cupos_disponibles = capacidad - inscripciones CONFIRMADAS (nunca un valor manual)\nconst publico = (e) => {\n  const capacidad = Number(e.capacidad) || 0;\n  const inscritos = ocupados[e.evento_id] || 0;\n  const cupos = Math.max(capacidad - inscritos, 0);\n  return {\n    evento_id: e.evento_id, nombre: e.nombre, categoria: e.categoria, descripcion: e.descripcion,\n    fecha: e.fecha, hora: e.hora, lugar: e.lugar, capacidad, imagen_url: e.imagen_url || '',\n    organizador: e.organizador, estado: e.estado,\n    inscritos_confirmados: inscritos, cupos_disponibles: cupos, lleno: cupos === 0\n  };\n};\nconst orden = (a, b) => (a.fecha + ' ' + a.hora).localeCompare(b.fecha + ' ' + b.hora);\n\nlet status = 200, body, tipo, count;\n\nif (entrada.accion === 'listado' || entrada.accion === 'filtro') {\n  let lista = eventos;\n  if (entrada.accion === 'filtro') lista = eventos.filter(e => norm(e.categoria) === norm(entrada.categoria));\n  const data = lista.map(publico).sort(orden);\n  tipo = entrada.accion === 'listado' ? 'LISTADO' : 'FILTRO';\n  count = data.length;\n  body = { ok: true, data, message: data.length + ' eventos' };\n} else {\n  const evento = eventos.find(e => e.evento_id === entrada.evento_id);\n  tipo = entrada.accion === 'detalle' ? 'DETALLE' : 'DISPONIBILIDAD';\n  if (!evento) {\n    status = 404; count = 0;\n    body = { ok: false, error: 'NO_ENCONTRADO', message: 'El evento no existe o no está disponible' };\n  } else {\n    const e = publico(evento);\n    count = 1;\n    body = entrada.accion === 'detalle'\n      ? { ok: true, data: e, message: 'Evento encontrado' }\n      : { ok: true, data: { evento_id: e.evento_id, capacidad: e.capacidad, inscritos_confirmados: e.inscritos_confirmados, cupos_disponibles: e.cupos_disponibles, lleno: e.lleno }, message: 'Disponibilidad calculada' };\n  }\n}\n\nreturn [{ json: {\n  status, body,\n  log: {\n    consulta_id: 'CON-' + Date.now() + '-' + Math.floor(Math.random() * 10000),\n    fecha: new Date().toISOString(), tipo,\n    evento_id: entrada.evento_id || '', categoria: entrada.categoria || '',\n    resultado_count: count, visitor_id: entrada.visitor_id, status_http: status\n  }\n} }];\n"
      }
    },
