    {
      "id": "328b3861-871f-489d-810b-d6782d4f0110",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst { body = {} } = $input.first().json;\nconst accion = String(body.accion || '').trim();\nconst visitor_id = String(body.visitor_id || 'anonimo').trim().slice(0, 80);\nconst evento_id = String(body.evento_id || '').trim();\nconst categoria = String(body.categoria || '').trim();\n\nif (!['listado', 'detalle', 'filtro', 'disponibilidad'].includes(accion)) return fail(400, 'VALIDACION', 'Acción no válida');\nif ((accion === 'detalle' || accion === 'disponibilidad') && !evento_id) return fail(400, 'VALIDACION', 'Falta evento_id');\nif (accion === 'filtro' && !categoria) return fail(400, 'VALIDACION', 'Falta la categoría');\n\nreturn [{ json: { accion, visitor_id, evento_id, categoria } }];\n"
      }
    },
