      "parameters": {
        "jsCode": "// Entrada mínima: inscripcion_id y evento_id\nconst body = $input.first().json.body || {};\nconst inscripcion_id = String(body.inscripcion_id || '').trim();\nconst evento_id = String(body.evento_id || '').trim().toUpperCase();\nconst faltan = [];\nif (!inscripcion_id) faltan.push('inscripcion_id');\nif (!evento_id) faltan.push('evento_id');\nreturn [{ json: { inscripcion_id, evento_id, completa: faltan.length === 0,\n  detalle: faltan.length ? 'Faltan datos: ' + faltan.join(' y ') : '' } }];"
      }
