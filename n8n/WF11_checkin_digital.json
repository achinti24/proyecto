    {
      "id": "04e9ad17-33a7-43cd-916a-146a51fc46d7",
      "name": "Reunir datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "jsCode": "// Junta lo leído y deja cada validación como un sí/no\nconst e = $('Validar entrada').first().json;\nconst inscripcion = $('Leer inscripción').all().map(i => i.json).find(r => r && r.inscripcion_id === e.inscripcion_id) || null;\nconst evento = $('Leer evento').all().map(i => i.json).find(r => r && String(r.evento_id).toUpperCase() === e.evento_id) || null;\nconst previos = $('Leer historial de check-in').all().map(i => i.json)\n  .filter(r => r && r.inscripcion_id === e.inscripcion_id && r.resultado === 'EXITOSO');\nreturn [{ json: {\n  inscripcion_id: e.inscripcion_id, evento_id: e.evento_id,\n  inscripcion, evento,\n  existeInscripcion: !!inscripcion,\n  existeEvento: !!evento,\n  eventoActivo: !!evento && evento.estado !== 'CANCELADO' && evento.estado !== 'BORRADOR',\n  corresponde: !!inscripcion && inscripcion.evento_id === e.evento_id,\n  // Duplicado: ya hay un check-in EXITOSO, o la inscripción ya figura como ASISTIO\n  yaIngreso: previos.length > 0 || (!!inscripcion && inscripcion.estado === 'ASISTIO'),\n  checkinPrevio: previos[0] || null,\n  confirmada: !!inscripcion && inscripcion.estado === 'CONFIRMADA'\n} }];"
      }
    },
