    {
      "id": "26b27b34-af0d-4008-83b7-a98bceb9c6a1",
      "name": "Preparar rechazo o duplicado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        520
      ],
      "parameters": {
        "jsCode": "// Toda solicitud que no termina en EXITOSO también se registra, con el motivo\nconst crypto = require('crypto');\nconst e = $('Validar entrada').first().json;\nlet d = null;\ntry { d = $('Reunir datos').first().json; } catch (err) { d = null; }\nconst iso = new Date().toISOString();\nlet resultado = 'RECHAZADO', status, codigo, detalle;\nif (!e.completa) { status = 400; codigo = 'DATOS_INCOMPLETOS'; detalle = e.detalle; }\nelse if (!d.existeInscripcion) { status = 404; codigo = 'INSCRIPCION_NO_EXISTE'; detalle = 'La inscripción ' + e.inscripcion_id + ' no existe'; }\nelse if (!d.existeEvento) { status = 404; codigo = 'EVENTO_NO_EXISTE'; detalle = 'El evento ' + e.evento_id + ' no existe'; }\nelse if (!d.eventoActivo) { status = 409; codigo = 'EVENTO_NO_ADMITE_INGRESO'; detalle = 'El evento ' + e.evento_id + ' está ' + d.evento.estado; }\nelse if (!d.corresponde) { status = 422; codigo = 'INSCRIPCION_DE_OTRO_EVENTO'; detalle = 'La inscripción pertenece a ' + d.inscripcion.evento_id + ', no a ' + e.evento_id; }\nelse if (d.yaIngreso) {\n  resultado = 'DUPLICADO'; status = 409; codigo = 'CHECKIN_DUPLICADO';\n  detalle = 'El ingreso ya había sido registrado' + (d.checkinPrevio ? ' (' + d.checkinPrevio.checkin_id + ', ' + d.checkinPrevio.fecha_checkin + ')' : '');\n}\nelse { status = 409; codigo = 'ESTADO_NO_PERMITE_INGRESO'; detalle = 'La inscripción está en ' + d.inscripcion.estado + '; solo CONFIRMADA puede ingresar'; }\n\nconst checkin_id = 'CHK-' + crypto.randomUUID();\nconst ins = d && d.inscripcion;\nreturn [{ json: {\n  checkin: { checkin_id, inscripcion_id: e.inscripcion_id, evento_id: e.evento_id, usuario_id: ins ? ins.usuario_id : '',\n             fecha_checkin: iso, resultado, detalle },\n  status,\n  respuesta: { ok: false, resultado, error: codigo, message: detalle,\n    data: { checkin_id, inscripcion_id: e.inscripcion_id, evento_id: e.evento_id,\n            evento_nombre: d && d.evento ? d.evento.nombre : '', nombre_acreditacion: ins ? ins.nombre_acreditacion : '',\n            estado_inscripcion: ins ? ins.estado : '',\n            checkin_previo: d && d.checkinPrevio ? { checkin_id: d.checkinPrevio.checkin_id, fecha_checkin: d.checkinPrevio.fecha_checkin } : null } }\n} }];"
      }
    },
