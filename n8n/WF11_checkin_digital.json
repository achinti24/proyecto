    {
      "id": "82f92104-8373-46d4-a349-935e0d4f76cd",
      "name": "Generar checkin_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        100
      ],
      "parameters": {
        "jsCode": "// Check-in válido: id único, fecha y hora, inscripción a ASISTIO y aviso por WF09\nconst crypto = require('crypto');\nconst d = $('Reunir datos').first().json;\nconst ins = d.inscripcion, ev = d.evento;\nconst ahora = new Date();\nconst iso = ahora.toISOString();\nconst checkin_id = 'CHK-' + crypto.randomUUID();\nconst cuando = ahora.toLocaleString('es-CO', { timeZone: 'America/Bogota', dateStyle: 'long', timeStyle: 'short' });\nconst inscripcion = {\n  inscripcion_id: ins.inscripcion_id, usuario_id: ins.usuario_id, evento_id: ins.evento_id, estado: 'ASISTIO',\n  fecha_inscripcion: ins.fecha_inscripcion, fecha_actualizacion: iso, nombre_acreditacion: ins.nombre_acreditacion,\n  observaciones: ins.observaciones, origen: ins.origen, orden_espera: ins.orden_espera\n};\nreturn [{ json: {\n  checkin: { checkin_id, inscripcion_id: ins.inscripcion_id, evento_id: ev.evento_id, usuario_id: ins.usuario_id,\n             fecha_checkin: iso, resultado: 'EXITOSO', detalle: 'Ingreso registrado. CONFIRMADA → ASISTIO' },\n  inscripcion,\n  auditoria: { auditoria_id: 'AUD-' + Date.now() + '-' + Math.floor(Math.random() * 1000), inscripcion_id: ins.inscripcion_id,\n               usuario_id: ins.usuario_id, evento_id: ev.evento_id, accion: 'CHECKIN', estado_anterior: 'CONFIRMADA',\n               estado_nuevo: 'ASISTIO', fecha: iso, resultado: 'OK', detalle: 'Check-in ' + checkin_id },\n  notificacion: { usuario_id: ins.usuario_id, tipo: 'CHECKIN', titulo: 'Ingreso registrado',\n    mensaje: 'Registramos tu ingreso a \"' + ev.nombre + '\" el ' + cuando + '. ¡Que disfrutes la noche!',\n    mensaje_registro: '', evento_id: ev.evento_id, inscripcion_id: ins.inscripcion_id,\n    clave_idempotencia: 'CHECKIN|' + ins.inscripcion_id },\n  status: 200,\n  respuesta: { ok: true, resultado: 'EXITOSO', message: 'Check-in realizado correctamente',\n    data: { checkin_id, inscripcion_id: ins.inscripcion_id, evento_id: ev.evento_id, evento_nombre: ev.nombre,\n            nombre_acreditacion: ins.nombre_acreditacion, fecha_checkin: iso, estado_inscripcion: 'ASISTIO' } }\n} }];"
      }
    },
