    {
      "id": "aff42829-3b32-4eda-b4aa-afe23b0c1e8c",
      "name": "Validar formulario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json;\nconst norm = (s) => String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst m = {};\nfor (const [k, v] of Object.entries(raw)) m[norm(k)] = v;\nconst s = (k) => (m[k] === undefined || m[k] === null ? '' : String(m[k]).trim());\nconst fail = (message) => [{ json: { error: { message } } }];\n\nconst CATEGORIAS = ['Cultura', 'Tecnología', 'Educación', 'Comunidad', 'Deportes', 'Networking', 'Emprendimiento'];\nconst accion = s('accion').toUpperCase();\nif (!['CREAR', 'CONSULTAR', 'ACTUALIZAR', 'PUBLICAR', 'CERRAR', 'CANCELAR'].includes(accion)) return fail('Selecciona una acción válida');\n\nconst evento_id = s('eventoid').toUpperCase();\nif (accion !== 'CREAR' && accion !== 'CONSULTAR' && !evento_id) return fail('Para esta acción debes indicar el Evento ID (ej. EVT-001)');\n\nconst datos = {};\nconst hoy = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10);\nconst valida = (fecha) => /^\\d{4}-\\d{2}-\\d{2}$/.test(fecha) && !isNaN(new Date(fecha + 'T00:00:00Z').getTime());\n\nif (accion === 'CREAR' || accion === 'ACTUALIZAR') {\n  const req = accion === 'CREAR';\n  const nombre = s('nombre'), cat = s('categoria'), desc = s('descripcion'), fecha = s('fecha'), hora = s('hora');\n  const lugar = s('lugar'), cap = s('capacidad'), img = s('imagenurl'), org = s('organizador'), est = s('estado').toUpperCase();\n\n  if (req && (!nombre || !cat || !desc || !fecha || !hora || !lugar || !cap || !org)) return fail('Para crear un evento completa nombre, categoría, descripción, fecha, hora, lugar, capacidad y organizador');\n  if (nombre) { if (nombre.length < 3 || nombre.length > 100) return fail('El nombre debe tener entre 3 y 100 caracteres'); datos.nombre = nombre; }\n  if (cat) {\n    const c = CATEGORIAS.find(x => norm(x) === norm(cat));\n    if (!c) return fail('Categoría no válida. Usa: ' + CATEGORIAS.join(', '));\n    datos.categoria = c;\n  }\n  if (desc) { if (desc.length > 500) return fail('La descripción admite máximo 500 caracteres'); datos.descripcion = desc; }\n  if (fecha) {\n    if (!valida(fecha)) return fail('La fecha no es válida (formato AAAA-MM-DD)');\n    if (req && fecha < hoy) return fail('La fecha del evento no puede estar en el pasado');\n    datos.fecha = fecha;\n  }\n  if (hora) { if (!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(hora)) return fail('La hora debe tener formato HH:MM (24 horas)'); datos.hora = hora; }\n  if (lugar) { if (lugar.length > 120) return fail('El lugar admite máximo 120 caracteres'); datos.lugar = lugar; }\n  if (cap) {\n    const n = Number(cap);\n    if (!Number.isInteger(n) || n < 1 || n > 100000) return fail('La capacidad debe ser un entero entre 1 y 100000');\n    datos.capacidad = n;\n  }\n  if (img) { if (!/^(https?:\\/\\/\\S+|\\/img\\/[\\w.-]+)$/i.test(img)) return fail('La URL de imagen debe iniciar con http(s):// o ser /img/archivo.svg'); datos.imagen_url = img; }\n  if (org) { datos.organizador = org; }\n  if (accion === 'CREAR') {\n    if (est && !['BORRADOR', 'PUBLICADO'].includes(est)) return fail('Al crear, el estado inicial solo puede ser BORRADOR o PUBLICADO');\n    datos.estado = est || 'BORRADOR';\n  }\n  if (accion === 'ACTUALIZAR' && !Object.keys(datos).length) return fail('Indica al menos un campo para actualizar');\n}\nreturn [{ json: { accion, evento_id, datos } }];\n"
      }
