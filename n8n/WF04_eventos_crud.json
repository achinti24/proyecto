    {
      "id": "f2810ed7-c51d-44a4-86ae-a49054ed6103",
      "name": "Ejecutar accion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "jsCode": "\nconst fail = (message) => [{ json: { error: { message } } }];\nconst e = $('Validar formulario').first().json;\nconst eventos = $('Leer eventos').all().map(i => i.json).filter(r => r.evento_id);\nconst insc = $('Leer inscripciones').all().map(i => i.json).filter(r => r.inscripcion_id);\nconst ahora = new Date().toISOString();\n\nconst confirmadas = (id) => insc.filter(r => r.evento_id === id && (r.estado === 'CONFIRMADA' || r.estado === 'ASISTIO')).length;\nconst fila = (r, cambios = {}) => ({\n  evento_id: r.evento_id, nombre: r.nombre, categoria: r.categoria, descripcion: r.descripcion, fecha: r.fecha, hora: r.hora,\n  lugar: r.lugar, capacidad: r.capacidad, imagen_url: r.imagen_url || '', organizador: r.organizador, estado: r.estado,\n  fecha_creacion: r.fecha_creacion, fecha_actualizacion: r.fecha_actualizacion, ...cambios\n});\nconst aud = (id, accion, detalle) => ({\n  auditoria_id: 'AUD-' + Date.now() + '-' + Math.floor(Math.random() * 1000), evento_id: id, accion, fecha: ahora, resultado: 'OK', detalle\n});\nconst linea = (r) => r.evento_id + ' | ' + r.nombre + ' | ' + r.estado + ' | ' + r.fecha + ' ' + r.hora + ' | cupos ' +\n  Math.max((Number(r.capacidad) || 0) - confirmadas(r.evento_id), 0) + '/' + r.capacidad;\n\nif (e.accion === 'CONSULTAR') {\n  if (!e.evento_id) {\n    const lista = eventos.map(linea);\n    return [{ json: { op: 'CONSULTAR', mensaje: lista.length ? lista.join('<br>') : 'No hay eventos registrados' } }];\n  }\n  const ev = eventos.find(r => r.evento_id === e.evento_id);\n  if (!ev) return fail('No existe el evento ' + e.evento_id);\n  return [{ json: { op: 'CONSULTAR', mensaje: linea(ev) + '<br>Categoría: ' + ev.categoria + '<br>Lugar: ' + ev.lugar + '<br>Organizador: ' + ev.organizador + '<br>' + ev.descripcion } }];\n}\n\nif (e.accion === 'CREAR') {\n  const nums = eventos.map(r => /^EVT-(\\d+)$/.exec(String(r.evento_id))).filter(Boolean).map(x => Number(x[1]));\n  const id = 'EVT-' + String((nums.length ? Math.max(...nums) : 0) + 1).padStart(3, '0');\n  const nuevo = { evento_id: id, nombre: '', categoria: '', descripcion: '', fecha: '', hora: '', lugar: '', capacidad: '',\n                  imagen_url: '', organizador: '', estado: 'BORRADOR', fecha_creacion: ahora, fecha_actualizacion: ahora, ...e.datos };\n  return [{ json: { op: 'CREAR', write: nuevo, auditoria: aud(id, 'CREAR', 'Evento creado en estado ' + nuevo.estado),\n                    mensaje: 'Evento ' + id + ' creado en estado ' + nuevo.estado, avisos: [] } }];\n}\n\nconst ev = eventos.find(r => r.evento_id === e.evento_id);\nif (!ev) return fail('No existe el evento ' + e.evento_id);\n\nif (e.accion === 'ACTUALIZAR') {\n  if (ev.estado === 'CANCELADO' || ev.estado === 'CERRADO') return fail('Un evento ' + ev.estado + ' no se puede modificar');\n  if (e.datos.capacidad !== undefined && e.datos.capacidad < confirmadas(ev.evento_id)) {\n    return fail('La capacidad no puede ser menor a las inscripciones confirmadas (' + confirmadas(ev.evento_id) + ')');\n  }\n  const nuevo = fila(ev, { ...e.datos, fecha_actualizacion: ahora });\n  return [{ json: { op: 'ACTUALIZAR', write: nuevo, auditoria: aud(ev.evento_id, 'ACTUALIZAR', 'Campos: ' + Object.keys(e.datos).join(', ')),\n                    mensaje: 'Evento ' + ev.evento_id + ' actualizado', avisos: [] } }];\n}\n\nconst destino = { PUBLICAR: 'PUBLICADO', CERRAR: 'CERRADO', CANCELAR: 'CANCELADO' }[e.accion];\nconst permitido = { PUBLICADO: ['BORRADOR'], CERRADO: ['PUBLICADO'], CANCELADO: ['BORRADOR', 'PUBLICADO', 'CERRADO'] }[destino];\nif (ev.estado === destino) return fail('El evento ya está en estado ' + destino);\nif (!permitido.includes(ev.estado)) return fail('No se puede pasar de ' + ev.estado + ' a ' + destino);\n\nconst nuevo = fila(ev, { estado: destino, fecha_actualizacion: ahora });\nconst avisos = [];\nif (destino === 'CANCELADO') {\n  for (const r of insc.filter(x => x.evento_id === ev.evento_id && (x.estado === 'CONFIRMADA' || x.estado === 'LISTA_ESPERA'))) {\n    avisos.push({ notif: {\n      usuario_id: r.usuario_id, tipo: 'EVENTO_CANCELADO', titulo: 'Evento cancelado',\n      mensaje: 'Lamentamos informarte que el evento \"' + ev.nombre + '\" (' + ev.fecha + ' ' + ev.hora + ') fue CANCELADO.',\n      evento_id: ev.evento_id, inscripcion_id: r.inscripcion_id,\n      clave_idempotencia: ['EVENTO_CANCELADO', r.usuario_id, ev.evento_id, r.inscripcion_id].join('|')\n    } });\n  }\n}\nreturn [{ json: { op: 'ESTADO', write: nuevo, auditoria: aud(ev.evento_id, e.accion, ev.estado + ' -> ' + destino),\n                  mensaje: 'Evento ' + ev.evento_id + ' ahora está ' + destino + (avisos.length ? ' (' + avisos.length + ' usuarios por notificar)' : ''), avisos } }];\n"
      }
    },
