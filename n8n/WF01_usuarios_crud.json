    {
      "id": "ab8b16a1-971a-475c-8d0e-da43f180e6d9",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        304
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst { body = {}, headers = {} } = $input.first().json;\nconst accion = String(body.accion || '').trim();\nconst auth = headers.authorization || '';\nconst token = auth.startsWith('Bearer ') ? auth.slice(7).trim() : '';\n\nif (!['crear', 'perfil', 'actualizar', 'desactivar'].includes(accion)) {\n  return fail(400, 'VALIDACION', 'Acción no válida');\n}\n\nif (accion === 'crear') {\n  const nombre = String(body.nombre || '').trim();\n  const email = String(body.email || '').trim().toLowerCase();\n  const password = String(body.password || '');\n  if (nombre.length < 2 || nombre.length > 80) return fail(400, 'VALIDACION', 'El nombre debe tener entre 2 y 80 caracteres');\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return fail(400, 'VALIDACION', 'El email no es válido');\n  if (password.length < 8 || password.length > 128) return fail(400, 'VALIDACION', 'La contraseña debe tener entre 8 y 128 caracteres');\n  return [{ json: { accion, nombre, email, password } }];\n}\n\nif (!token) return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\nreturn [{ json: { accion, token, nombre: body.nombre, password: body.password } }];\n"
      }
    },
