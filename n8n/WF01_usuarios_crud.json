      "position": [
        1328,
        208
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst crypto = require('crypto');\nconst entrada = $('Validar entrada').first().json;\n\nconst existe = $input.all().some(i => i.json && i.json.usuario_id);\nif (existe) return fail(409, 'EMAIL_DUPLICADO', 'Ya existe una cuenta con ese email');\n\nconst salt = crypto.randomBytes(16).toString('hex');\nconst hash = crypto.pbkdf2Sync(entrada.password, salt, 100000, 64, 'sha512').toString('hex');\nconst ahora = new Date().toISOString();\n\nreturn [{ json: { usuario: {\n  usuario_id: 'USR-' + crypto.randomUUID(),\n  nombre: entrada.nombre,\n  email_normalizado: entrada.email,\n  password_hash: hash,\n  password_salt: salt,\n  estado: 'ACTIVO',\n  fecha_registro: ahora,\n  fecha_actualizacion: ahora\n} } }];\n"
      }
