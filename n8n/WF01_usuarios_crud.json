      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst entrada = $('Validar entrada').first().json;\nconst fila = $input.all().map(i => i.json).find(r => r.session_token === entrada.token);\n\nif (!fila || fila.estado !== 'ACTIVA') return fail(401, 'SESION_INVALIDA', 'Sesión no válida');\nif (new Date(fila.expira_en) <= new Date()) return fail(401, 'SESION_INVALIDA', 'La sesión expiró');\n\nreturn [{ json: { usuario_id: fila.usuario_id } }];\n"
      }
