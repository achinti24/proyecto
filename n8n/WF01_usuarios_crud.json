    {
      "id": "be14f754-04b0-4d85-90e0-03efb6ad4801",
      "name": "Preparar operacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        704
      ],
      "parameters": {
        "jsCode": "const fail = (status, code, message) => [{ json: { error: { status, code, message } } }];\n\nconst crypto = require('crypto');\nconst entrada = $('Validar entrada').first().json;\nconst usuarioId = $('Validar sesion').first().json.usuario_id;\n\nconst fila = $input.all().map(i => i.json).find(r => r.usuario_id === usuarioId);\nif (!fila) return fail(404, 'NO_ENCONTRADO', 'Usuario no encontrado');\nif (fila.estado !== 'ACTIVO') return fail(403, 'USUARIO_INACTIVO', 'La cuenta está inactiva');\n\nconst publico = (u) => ({\n  usuario_id: u.usuario_id, nombre: u.nombre, email: u.email_normalizado,\n  estado: u.estado, fecha_registro: u.fecha_registro\n});\n\nif (entrada.accion === 'perfil') {\n  return [{ json: { accion: 'perfil', respuesta: publico(fila), message: 'Perfil obtenido' } }];\n}\n\nconst ahora = new Date().toISOString();\nconst actualizado = {\n  usuario_id: fila.usuario_id, nombre: fila.nombre, email_normalizado: fila.email_normalizado,\n  password_hash: fila.password_hash, password_salt: fila.password_salt,\n  estado: fila.estado, fecha_registro: fila.fecha_registro, fecha_actualizacion: ahora\n};\nlet auditoria, message;\n\nif (entrada.accion === 'desactivar') {\n  actualizado.estado = 'INACTIVO';\n  auditoria = { accion: 'DESACTIVAR', detalle: 'Cuenta desactivada por el usuario' };\n  message = 'Cuenta desactivada';\n} else {\n  const nombre = entrada.nombre === undefined || entrada.nombre === null ? null : String(entrada.nombre).trim();\n  const password = entrada.password ? String(entrada.password) : '';\n  if (nombre === null && !password) return fail(400, 'VALIDACION', 'No hay nada que actualizar');\n  if (nombre !== null && (nombre.length < 2 || nombre.length > 80)) return fail(400, 'VALIDACION', 'El nombre debe tener entre 2 y 80 caracteres');\n  if (password && (password.length < 8 || password.length > 128)) return fail(400, 'VALIDACION', 'La contraseña debe tener entre 8 y 128 caracteres');\n\n  const cambios = [];\n  if (nombre !== null) { actualizado.nombre = nombre; cambios.push('nombre'); }\n  if (password) {\n    const salt = crypto.randomBytes(16).toString('hex');\n    actualizado.password_salt = salt;\n    actualizado.password_hash = crypto.pbkdf2Sync(password, salt, 100000, 64, 'sha512').toString('hex');\n    cambios.push('password');\n  }\n  auditoria = { accion: 'ACTUALIZAR', detalle: 'Campos: ' + cambios.join(', ') };\n  message = 'Perfil actualizado';\n}\n\nreturn [{ json: { accion: entrada.accion, update: actualizado, auditoria, respuesta: publico(actualizado), message } }];\n"
      }
    },
