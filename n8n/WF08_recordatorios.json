    {
      "id": "d898dfe4-aabc-4626-a554-50249ec1f341",
      "name": "Calcular recordatorios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "\nconst eventos = $('Filtrar publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst confirmadas = $('Filtrar confirmadas').all().map(i => i.json).filter(r => r.inscripcion_id && r.estado === 'CONFIRMADA');\nconst previos = $input.all().map(i => i.json).filter(r => r.clave_idempotencia);\nconst ahora = new Date();\nconst iso = ahora.toISOString();\nconst out = [];\nconst TIPOS = [\n  { tipo: 'RECORDATORIO_1H', horas: 1, texto: 'en menos de 1 hora' },\n  { tipo: 'RECORDATORIO_24H', horas: 24, texto: 'en menos de 24 horas' }\n];\n\nfor (const ev of eventos) {\n  const hora = String(ev.hora || '00:00').slice(0, 5);\n  const inicio = new Date(String(ev.fecha) + 'T' + hora + ':00-05:00');\n  if (isNaN(inicio.getTime())) continue;\n  const horasRestantes = (inicio.getTime() - ahora.getTime()) / 3600000;\n  if (horasRestantes <= 0) continue;\n  // Solo el recordatorio mas cercano que aplique (1H antes que 24H)\n  const t = TIPOS.find(x => horasRestantes <= x.horas);\n  if (!t) continue;\n\n  for (const ins of confirmadas.filter(r => r.evento_id === ev.evento_id)) {\n    const clave = [ins.usuario_id, ev.evento_id, t.tipo].join('|');\n    if (previos.some(p => p.clave_idempotencia === clave && p.estado === 'ENVIADO')) continue;\n    out.push({ json: {\n      rec: {\n        recordatorio_id: 'REC-' + Date.now() + '-' + Math.floor(Math.random() * 100000), usuario_id: ins.usuario_id,\n        evento_id: ev.evento_id, inscripcion_id: ins.inscripcion_id, tipo_recordatorio: t.tipo,\n        fecha_programada: new Date(inicio.getTime() - t.horas * 3600000).toISOString(), fecha_envio: iso, clave_idempotencia: clave\n      },\n      notif: {\n        usuario_id: ins.usuario_id, tipo: t.tipo, titulo: 'Recordatorio: ' + ev.nombre,\n        mensaje: 'Tu evento \"' + ev.nombre + '\" empieza ' + t.texto + ' (' + ev.fecha + ' ' + hora + ') en ' + ev.lugar + '. ¡Nos vemos allí!',\n        evento_id: ev.evento_id, inscripcion_id: ins.inscripcion_id, clave_idempotencia: clave\n      }\n    } });\n  }\n}\nreturn out;\n"
      }
    },
